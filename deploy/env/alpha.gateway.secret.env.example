# gateway 런타임 비밀 — `alpha.gateway.secret.env` 로 복사해 채운다. **커밋 금지.**
#
# ⚠️ **값을 이 파일에 채우지 않는다.** `.example` 은 커밋 대상이고 이 저장소는 public 리모트다.
#    채울 곳은 `.example` 을 뗀 `alpha.gateway.secret.env` 이며, 그 이름이면 .gitignore 가 잡는다.
#
# 이 파일은 Helm values 를 거치지 않는다. 배포 스크립트가 kubectl 로 Secret 을 만들고
# 차트는 이름으로 참조만 한다. 그래서 ① git 에 올라갈 경로가 없고
# ② `helm get values -a` 로도 나오지 않는다.
#
# 형식: KEY=VALUE (따옴표 없이). `#` 로 시작하는 줄과 빈 줄은 무시된다.
# ⚠️ 값에 `=` 가 들어가도 첫 `=` 까지만 키로 본다. 값을 따옴표로 감싸면 따옴표까지 값이 된다.

# ── 런타임 DB (R2DBC) ─────────────────────────────────────────────────────────
# ⚠️ Flyway 용 JDBC URL 과 **둘 다** 필요하다. 한쪽만 틀리면 "런타임은 되는데 마이그레이션만
#    실패" 또는 그 반대로 갈려, 증상이 서로 달라 원인을 찾기 어렵다.
#
# ⚠️ **사설 IP 를 쓴다.** 파드는 클러스터 내부에서 사설망으로 붙는다. 공인 IP(FIP)를 쓰면
#    보안그룹에 막혀 `The connection attempt failed` 로 기동이 실패한다 — 인증 실패가 아니라
#    TCP 연결 실패라 로그만 보면 자격증명 문제로 오해하기 쉽다. FIP 는 로컬 psql·DBeaver 전용이다.
SPRING_R2DBC_URL=r2dbc:postgresql://<pg-private-ip>:5432/unigate
SPRING_R2DBC_USERNAME=
SPRING_R2DBC_PASSWORD=

# ── 마이그레이션 (Flyway · JDBC · 부팅 시 1회) ────────────────────────────────
SPRING_FLYWAY_URL=jdbc:postgresql://<pg-private-ip>:5432/unigate
SPRING_FLYWAY_USER=
SPRING_FLYWAY_PASSWORD=

# ── Valkey Sentinel (세션 · rate limit) ───────────────────────────────────────
# ⚠️ 이 좌표가 틀리면 파드는 뜨지만 readiness 그룹에 redis 가 있어 **영원히 NotReady** 다.
VALKEY_SENTINEL_NODES=<valkey-sentinel-host>:26379
VALKEY_SENTINEL_MASTER=mymaster
VALKEY_PASSWORD=

# ── Keycloak (OIDC client · 로그인용) ─────────────────────────────────────────
# client secret 은 `setup-realm.sh --env alpha` 실행 후 출력에서 회수한다.
KEYCLOAK_ISSUER_URI=https://<keycloak-host>/realms/unigate
KEYCLOAK_OAUTH_CLIENT_ID=unigate-client
KEYCLOAK_OAUTH_CLIENT_SECRET=

# ── CORS ─────────────────────────────────────────────────────────────────────
# FE 콘솔을 다른 호스트에 둘 때만 필요하다. 스킴+호스트만, **끝 슬래시·경로 금지** —
# Origin 헤더와 문자열이 정확히 같아야 하고, 다르면 조용히 차단된다.
# 비워 두면 CORS 가 꺼지고 콘솔의 모든 요청이 막힌다.
UNIGATE_CORS_ALLOWED_ORIGINS=https://<console-host>

# ── 로그인·로그아웃 착지 ──────────────────────────────────────────────────────
# FE 를 다른 호스트에 둘 때 **CORS 와 짝으로** 반드시 함께 넣는다.
# 빠뜨리면 착지가 게이트웨이 루트(`/`)가 되고 거기엔 FE 가 없어 401 이다.
# 증상이 "로그인은 성공하는데 화면이 안 뜬다" 하나뿐이라 원인을 Keycloak 으로 오해하기 쉽다 —
# Keycloak 의 redirectUris 는 **인가 코드 배달 주소**일 뿐 착지가 아니다.
#
# ⚠️ 위 CORS 와 달리 **끝 슬래시가 필요하다.** 이 값은 로그아웃 시
#    Keycloak client 의 `post.logout.redirect.uris` 와 문자열 대조되는데,
#    `setup-realm.sh --console-host` 가 등록하는 값이 `https://<console-host>/` 다.
#    슬래시가 없으면 로그아웃만 `invalid_redirect_uri` 로 거절된다.
UNIGATE_FRONTEND_BASE_URI=https://<console-host>/

# ── 선택값 (기본값 있음) ──────────────────────────────────────────────────────
# 다운스트림 토큰의 기대 audience. 기본값이 대개 맞다.
TOKEN_VERIFIER_EXPECTED_AUDIENCE=unigate-downstream-demo
# 트레이싱 샘플링. alpha 는 100%. 비용을 보고 낮춘다.
TRACING_SAMPLING_PROBABILITY=1.0
