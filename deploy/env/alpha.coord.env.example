# 배포 좌표 — 비밀은 아니지만 **실제 좌표**라 커밋하지 않는다(CLAUDE.md §8).
#
# 이 파일을 `alpha.coord.env` 로 복사해 실제 값을 채운다.
# 비밀(비밀번호·client secret)은 여기가 아니라 `alpha.<app>.secret.env` 로 간다.
#
# ⚠️ **값을 이 파일에 채우지 않는다.** `.example` 은 커밋 대상이고 이 저장소는 public 리모트다.
#    채울 곳은 `.example` 을 뗀 `alpha.coord.env` 이며, 그 이름이면 .gitignore 가 자동으로 잡는다.
#
# ── 왜 secret 과 좌표를 나누는가 ────────────────────────────────────────────────
# 좌표(네임스페이스·호스트·레지스트리)는 유출돼도 직접 피해가 없고, Helm values 로 들어가
# `kubectl get ingress` 같은 명령에서 어차피 보인다. 비밀과 같은 통에 담으면 무엇이 진짜
# 비밀인지 흐려지고, 호스트 하나 바꾸려고 secret 을 다시 만들어야 한다.

# 배포 네임스페이스
UNIGATE_NAMESPACE=

# 컨테이너 레지스트리 경로(앱 이름 앞까지). 예: registry.internal/unigate
# 최종 이미지는 <UNIGATE_REGISTRY>/<app>:<tag> 가 된다.
UNIGATE_REGISTRY=

# 이미지 pull secret 이름. 대상 네임스페이스에 **미리** 존재해야 한다.
UNIGATE_IMAGE_PULL_SECRET=harbor-pull

# 게이트웨이 ingress host (외부 진입점)
UNIGATE_GATEWAY_HOST=

# 샘플 FE 콘솔 host. demo-fe 를 배포할 때만 필요하다.
UNIGATE_CONSOLE_HOST=

# ingress TLS secret 이름(클러스터에 이미 있는 와일드카드 인증서 등)
UNIGATE_TLS_SECRET=ssl-common

# 빌드 대상 플랫폼. 노드 아키텍처와 맞아야 한다.
# ⚠️ Apple Silicon 에서 비워 두면 arm64 이미지가 만들어져 amd64 노드에서
#    `no match for platform in manifest` 로 ImagePullBackOff 가 난다.
UNIGATE_PLATFORM=linux/amd64
