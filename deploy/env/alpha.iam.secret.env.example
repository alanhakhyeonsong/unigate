# iam 런타임 비밀 — `alpha.iam.secret.env` 로 복사해 채운다. **커밋 금지.**
#
# ⚠️ **값을 이 파일에 채우지 않는다.** `.example` 은 커밋 대상이고 이 저장소는 public 리모트다.

# ── DB ────────────────────────────────────────────────────────────────────────
# ⚠️ gateway 와 **다른 DB** 다(`unigate_iam`). 같은 DB 를 가리키면 Flyway 이력이 충돌해
#    한쪽 마이그레이션이 실패한다 — 두 앱이 각자 V1 을 갖고 있다.
# JDBC 하나만 있으면 된다(Flyway 가 이 datasource 를 물려받는다).
#
# ⚠️ **사설 IP 를 쓴다.** 근거는 alpha.gateway.secret.env.example 의 DB 항목 주석 참조.
IAM_DATASOURCE_URL=jdbc:postgresql://<pg-private-ip>:5432/unigate_iam
IAM_DATASOURCE_USERNAME=
IAM_DATASOURCE_PASSWORD=

# ── Keycloak Admin (service account) ──────────────────────────────────────────
# ⚠️ gateway 의 로그인 client 와 **다른 client** 다. 관리 자격증명이 유출돼도 로그인 흐름이
#    무사하도록 분리했다(IAM_PLATFORM_DECISION.md §14).
# server-url 은 realm 경로가 아니라 **base URL** 이다(issuer 와 다르다).
# client secret 은 `setup-realm.sh --env alpha` 실행 후 출력에서 회수한다.
KEYCLOAK_URL=https://<keycloak-host>
KEYCLOAK_REALM=unigate
KEYCLOAK_IAM_CLIENT_ID=unigate-iam
KEYCLOAK_IAM_CLIENT_SECRET=

# ── 선택값 (기본값 있음) ──────────────────────────────────────────────────────
# 이 값을 올리면 **기존 동의가 일제히 무효**가 되어 전 사용자가 재동의해야 한다.
# 인프라 설정이 아니라 비즈니스 결정이므로 배포 때 무심코 바꾸지 않는다.
IAM_CURRENT_TOS_VERSION=v1
TRACING_SAMPLING_PROBABILITY=1.0
