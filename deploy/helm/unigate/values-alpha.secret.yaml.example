# === 배포 secret 오버레이 예시 ===
# 실제 파일명: values-alpha.secret.yaml (반드시 .gitignore 대상 — 커밋 금지)
# 사용: helm upgrade --install ... -f values-alpha.yaml -f values-alpha.secret.yaml
#
# ⚠️ 참조 프로젝트(ccp)는 평문 secret 을 커밋하지만 unigate 는 금지한다.
#    아래 <...> 자리표시자를 공유 자원 실제값으로 채워 로컬에만 둔다.
#
# ⚠️ R2DBC 이원화: 런타임은 r2dbc://, Flyway 마이그레이션은 jdbc:// 두 URL 모두 필요.
# ⚠️ Keycloak: 인스턴스 공유 · realm 격리 → 전용 realm 'unigate'.

secrets:
  enabled: true
  data:
    # --- 런타임 DB (R2DBC, reactive) ---
    SPRING_R2DBC_URL: "r2dbc:postgresql://<shared-pg-host>:5432/unigate"
    SPRING_R2DBC_USERNAME: "<db-user>"
    SPRING_R2DBC_PASSWORD: "<db-password>"

    # --- 마이그레이션 (Flyway, JDBC, 부팅 시 1회) ---
    SPRING_FLYWAY_URL: "jdbc:postgresql://<shared-pg-host>:5432/unigate"
    SPRING_FLYWAY_USER: "<db-user>"
    SPRING_FLYWAY_PASSWORD: "<db-password>"

    # --- Valkey Sentinel (공유) ---
    VALKEY_SENTINEL_NODES: "<valkey-sentinel-host>:26379"
    VALKEY_SENTINEL_MASTER: "mymaster"
    VALKEY_PASSWORD: "<valkey-password>"

    # --- Keycloak (인스턴스 공유 · realm 격리: unigate) ---
    KEYCLOAK_ISSUER_URI: "https://<keycloak-host>/realms/unigate"
    KEYCLOAK_OAUTH_CLIENT_ID: "unigate-client"
    KEYCLOAK_OAUTH_CLIENT_SECRET: "<oauth-client-secret>"
